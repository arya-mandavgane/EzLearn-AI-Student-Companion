# AI Provider
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
AI_PROVIDER=gemini
AI_MOCK=false
AI_MOCK_INVALID=false

# Database (SQLite for local dev, set to postgresql://... for production)
DATABASE_URL=sqlite:///./study_companion.db

# Security (generate a long random string for production)
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# File size limits (bytes)
MAX_FILE_BYTES=10485760
MAX_PDF_BYTES=20971520
MAX_AUDIO_SECONDS=60
MAX_TEXT_CHARS=50000
MAX_EXPLAIN_CHARS=8000
